{
  "name": "@perfonext/render-mcp",
  "version": "0.5.2",
  "mcpName": "io.github.souvikdu/perfonext-render-mcp",
  "description": "MCP server for analyzing Next.js React Profiler exports: render summaries, rerender causes, hot commits, and profile diffing",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "perfonext-render-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && shx chmod +x dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "github-copilot",
    "nextjs",
    "react-profiler",
    "render",
    "rerender",
    "hydration",
    "performance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/souvikdu/perfonext-render-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/souvikdu/perfonext-render-mcp/issues"
  },
  "homepage": "https://github.com/souvikdu/perfonext-render-mcp#readme",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^17.9.0",
    "prettier": "^3.4.2",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.10"
  }
}
